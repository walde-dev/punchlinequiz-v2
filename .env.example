# ─────────────────────────────────────────────────────────────
# punchlinequiz-v2 — environment variables (source of truth)
# Copy to .env (root) and/or apps/web/.env and fill in values.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Clerk authentication
# ─────────────────────────────────────────────────────────────
# Browser-exposed publishable key (Vite inlines VITE_*-prefixed vars).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace
# Server-side keys used by the Clerk request middleware + backend API.
CLERK_PUBLISHABLE_KEY=pk_test_replace
CLERK_SECRET_KEY=sk_test_replace

# Neon Postgres connection string. Required.
# Used by: apps/web (runtime), packages/db (migrations, seed, backfill).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Bearer token for the admin API (POST/PATCH/DELETE /api/admin/*).
# Required in any environment that should accept admin writes
# (hermes CLI, pquiz-* skills, etc.). Generate with: openssl rand -base64 32
PQUIZ_ADMIN_TOKEN=replace-with-long-random-string

# Axiom log ingest. Optional — if unset, server-side events are no-ops.
# Token: create an API token with ingest permission for the dataset below.
AXIOM_TOKEN=
AXIOM_DATASET=punchlinequiz
# Ingest host. Defaults to https://api.axiom.co (US). Ingest is region-pinned to
# the dataset's edge deployment, so EU datasets MUST set the EU edge host:
#   https://eu-central-1.aws.edge.axiom.co
AXIOM_URL=https://eu-central-1.aws.edge.axiom.co

# ─────────────────────────────────────────────────────────────
# Sentry error tracking
# ─────────────────────────────────────────────────────────────
# Optional — if the DSN is unset, Sentry init no-ops (server + client).
# Runtime DSN: server reads SENTRY_DSN, client reads the VITE_-prefixed one
# (same project, both can be the same DSN value).
SENTRY_DSN=
VITE_SENTRY_DSN=
# Optional. Default to VERCEL_ENV/NODE_ENV and the git SHA when unset.
# SENTRY_ENVIRONMENT=
# VITE_SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=
# VITE_SENTRY_RELEASE=
# Build-time only (set in the Vercel build env) — enables source-map upload.
# When SENTRY_AUTH_TOKEN is unset the Vite plugin is skipped entirely.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# EU-region orgs only: point source-map upload at the EU host (else it 403s
# against the US default). US orgs can leave this unset.
SENTRY_URL=https://de.sentry.io

# Only used by local skill tooling (impeccable). Not needed in Vercel.
# IMPECCABLE_CONTEXT_DIR=

# Genius API — used by scripts/lyrics/* to fetch real lyrics for curation.
# Register a client at https://genius.com/api-clients. Either set
# GENIUS_ACCESS_TOKEN (the "Client Access Token") directly, or provide
# CLIENT_ID + CLIENT_SECRET — the scripts fall back to CLIENT_SECRET as Bearer.
NEXT_PUBLIC_GENIUS_CLIENT_ID=
GENIUS_CLIENT_SECRET=
# GENIUS_ACCESS_TOKEN=

# Target for `pnpm lyrics:insert`. Defaults to http://localhost:3000.
# PQUIZ_BASE_URL=https://punchlinequiz.de
