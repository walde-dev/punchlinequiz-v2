{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", ".vercel/output/**"],
      "env": [
        "DATABASE_URL",
        "PQUIZ_ADMIN_TOKEN",
        "NEXT_PUBLIC_GENIUS_CLIENT_ID",
        "GENIUS_CLIENT_SECRET",
        "GENIUS_ACCESS_TOKEN",
        "VITE_CLERK_PUBLISHABLE_KEY",
        "CLERK_PUBLISHABLE_KEY",
        "CLERK_SECRET_KEY",
        "LINEAR_API_KEY",
        "SENTRY_DSN",
        "VITE_SENTRY_DSN",
        "VITE_SENTRY_ENVIRONMENT",
        "VITE_SENTRY_RELEASE",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_URL",
        "AXIOM_TOKEN",
        "AXIOM_DATASET",
        "AXIOM_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
